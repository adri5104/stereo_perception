
@article{autonomous_vehicles_perception_survey,
	title = {Autonomous vehicle perception: {The} technology of today and tomorrow},
	volume = {89},
	issn = {0968090X},
	shorttitle = {Autonomous vehicle perception},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S0968090X18302134},
	doi = {10.1016/j.trc.2018.02.012},
	abstract = {Perception system design is a vital step in the development of an autonomous vehicle (AV). With the vast selection of available oﬀ-the-shelf schemes and seemingly endless options of sensor systems implemented in research and commercial vehicles, it can be diﬃcult to identify the optimal system for one’s AV application. This article presents a comprehensive review of the state-of-the-art AV perception technology available today. It provides up-to-date information about the advantages, disadvantages, limits, and ideal applications of speciﬁc AV sensors; the most prevalent sensors in current research and commercial AVs; autonomous features currently on the market; and localization and mapping methods currently implemented in AV research. This information is useful for newcomers to the AV ﬁeld to gain a greater understanding of the current AV solution landscape and to guide experienced researchers towards research areas requiring further development. Furthermore, this paper highlights future research areas and draws conclusions about the most eﬀective methods for AV perception and its eﬀect on localization and mapping. Topics discussed in the Perception and Automotive Sensors section focus on the sensors themselves, whereas topics discussed in the Localization and Mapping section focus on how the vehicle perceives where it is on the road, providing context for the use of the automotive sensors. By improving on current state-of-the-art perception systems, AVs will become more robust, reliable, safe, and accessible, ultimately providing greater eﬃciency, mobility, and safety beneﬁts to the public.},
	language = {en},
	urldate = {2024-10-25},
	journal = {Transportation Research Part C: Emerging Technologies},
	author = {Van Brummelen, Jessica and O’Brien, Marie and Gruyer, Dominique and Najjaran, Homayoun},
	month = apr,
	year = {2018},
	keywords = {Survey, Perception paradigms},
	pages = {384--406},
	annote = {Important notes
Classification of perception algorithms 
A) Classification 1
-{\textgreater} mediated perception
-{\textgreater} behaviour reflex perception
-{\textgreater} direct perception !
B) Tipe of data
-{\textgreater} Vision based
-{\textgreater} Point cloud based
},
	file = {PDF:/home/adrian/Zotero/storage/TDHLRZZG/Van Brummelen et al. - 2018 - Autonomous vehicle perception The technology of today and tomorrow.pdf:application/pdf},
}

